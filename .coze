[project]
entrypoint = "/"
requires = ["python-3.12"]
project_type = "web"

[dev]
build = ["bash", "-c", "pip install --no-cache-dir -r requirements.txt"]
run = ["sh", "-c", "python3 web_app.py --host 0.0.0.0 --port ${DEPLOY_RUN_PORT} --no-browser"]

[deploy]
build = ["bash", "-c", "pip install --no-cache-dir -r requirements.txt"]
run = ["sh", "-c", "python3 web_app.py --host 0.0.0.0 --port ${DEPLOY_RUN_PORT} --no-browser"]