# 火山方舟 API（必填）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_PERFORMANCE_MODEL=doubao-seed-2-0-lite-260215

# CZMIYOU 账号中心（正式部署启用；本地单机开发可保持 false）
MIYO_AUTH_ENABLED=false
MIYO_LOGIN_URL=
AUTH_TOKEN_SECRET=
MIYO_MYSQL_HOST=
MIYO_MYSQL_PORT=3306
MIYO_MYSQL_USER=
MIYO_MYSQL_PASSWORD=
MIYO_MYSQL_DATABASE=
MIYO_MINIMUM_BALANCE=0.10
MIYO_COOKIE_SECURE=true
# 固定业务契约：产品 ID 4 / miyo_fashion，不允许通过环境变量改成其他产品。

# 火山方舟人物角色库 / Assets API（真实人物复刻重绘的查询、上传、删除需要）
# 账号需开通 Seedance 高级创作入门版或更高权益，并给同一账号/项目授予 ArkFullAccess。
# 可使用与下方 TOS 相同的火山 Access Key / Secret Key；单独填写时优先使用这里。
ARK_ASSETS_ACCESS_KEY_ID=
ARK_ASSETS_SECRET_ACCESS_KEY=
ARK_ASSETS_REGION=cn-beijing
ARK_ASSETS_HOST=open.volcengineapi.com
ARK_ASSETS_PROJECT_NAME=default
# 可选：真人 H5 活体认证完成后的返回地址；不填则使用当前本地服务回调页。
ARK_ASSETS_CALLBACK_URL=

# 火山对象存储 TOS（本地视频上传、人物角色库上传时必填）
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=
TOS_REGION=cn-beijing
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_PREFIX=seedance-inputs

# 通常不需要填写；程序会自动定位自带的 FFmpeg
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
