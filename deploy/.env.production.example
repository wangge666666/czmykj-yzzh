DEPTHFLOW_DOMAIN=video.example.com
DEPTHFLOW_SITE_USER=replace-with-login-name
DEPTHFLOW_SITE_PASSWORD=replace-with-a-long-random-password

# CZMIYOU 登录、产品 4 时间卡与中央计费（正式环境必须启用）
MIYO_AUTH_ENABLED=true
MIYO_LOGIN_URL=https://replace-with-czmiyou-login.example.com
AUTH_TOKEN_SECRET=replace-with-the-same-32-plus-character-secret-as-login-center
MIYO_MYSQL_HOST=replace-with-central-mysql-host
MIYO_MYSQL_PORT=3306
MIYO_MYSQL_USER=replace-with-central-mysql-user
MIYO_MYSQL_PASSWORD=replace-with-central-mysql-password
MIYO_MYSQL_DATABASE=replace-with-central-mysql-database
MIYO_MINIMUM_BALANCE=0.10
MIYO_COOKIE_SECURE=true

# 方舟 / Seedance / Seedream
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山角色库 Assets API（按当前本地 .env 的有效变量迁移）
ARK_ASSETS_ACCESS_KEY_ID=
ARK_ASSETS_SECRET_ACCESS_KEY=
ARK_ASSETS_PROJECT_NAME=default
ARK_ASSETS_HOST=open.volcengineapi.com
ARK_ASSETS_REGION=cn-beijing

# 如角色库或视频公网引用仍使用 TOS，请迁移当前项目中的有效配置。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
