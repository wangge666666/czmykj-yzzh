DEPTHFLOW_DOMAIN=video.example.com
DEPTHFLOW_SITE_USER=replace-with-login-name
DEPTHFLOW_SITE_PASSWORD=replace-with-a-long-random-password

# 方舟 / Seedance / Seedream
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山角色库 Assets API（按当前本地 .env 的有效变量迁移）
ARK_ASSETS_ACCESS_KEY_ID=
ARK_ASSETS_SECRET_ACCESS_KEY=
ARK_ASSETS_PROJECT_NAME=default
ARK_ASSETS_HOST=open.volcengineapi.com
ARK_ASSETS_REGION=cn-beijing

# 如角色库或视频公网引用仍使用 TOS，请迁移当前项目中的有效配置。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
